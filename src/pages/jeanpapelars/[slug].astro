---
import Base from '../../layouts/Base.astro';
import {papers} from '../../lib/data.mjs';
export function getStaticPaths(){return papers.map(p=>({params:{slug:p.slug},props:{p}}))}
const {p}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<Base title={p.title} description={p.subtitle}><article class="container paper"><a href={`${base}jeanpapelars/`} class="text-link">← Retour aux Jeanpapelars</a><div style="margin-top:35px" class="eyebrow">{p.section} / JEANPAPELAR N° {p.num} / VERSION 0.1</div><h1 class="page-title">{p.title}</h1><p class="page-lead">{p.subtitle}</p><div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:25px" class="micro"><span>{p.date}</span><span>{p.read}</span><span>STATUT : {p.status}</span></div><div class="intro">{p.intro}</div>{p.paragraphs.map((para,i)=><section><h2>{['Le point de départ','L’hypothèse de travail','Ce qui reste à éprouver'][i]}</h2><p>{para}</p></section>)}<div class="question"><span class="eyebrow">QUESTION OUVERTE</span><p>{p.question}</p></div><div>{p.tags.map(tag=><span class="tag">#{tag}</span>)}</div><div class="notice" style="margin-top:45px">Note éditoriale : texte d’exemple du MVP, à vérifier, compléter et approuver avant publication. Une réflexion ou hypothèse n’est pas une démonstration.</div></article></Base>
