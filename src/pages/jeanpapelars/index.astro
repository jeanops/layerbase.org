---
import Base from '../../layouts/Base.astro';
import {papers} from '../../lib/data.mjs';
const base=import.meta.env.BASE_URL;
---
<Base title="Jeanpapelars"><div class="container"><section class="page-hero"><span class="eyebrow">BIBLIOTHÈQUE / ESSAIS</span><h1 class="page-title">Les Jeanpapelars.</h1><p class="page-lead">Une archive d’idées en mouvement. Une publication peut évoluer, se préciser ou être réfutée : l’essentiel est d’en conserver la trace.</p></section><div class="filterbar" id="filters"><button class="filter active" data-filter="Tous">Tout voir</button><button class="filter" data-filter="Réflexion">Réflexions</button><button class="filter" data-filter="Hypothèse">Hypothèses</button><button class="filter" data-filter="Question ouverte">Questions ouvertes</button></div><div class="card-grid" id="papers">{papers.map(p=><a class="card" data-status={p.status} href={`${base}jeanpapelars/${p.slug}/`}><span class="num">{p.section} / N° {p.num} · {p.read}</span><h3>{p.title}</h3><p>{p.subtitle}</p><div class="card-foot"><span class="pill">{p.status}</span><span class="arrow">↗</span></div></a>)}</div></div><script>document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{const f=b.getAttribute('data-filter');document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('[data-status]').forEach(x=>x.hidden=f!=='Tous'&&x.getAttribute('data-status')!==f)}));</script><style>[hidden]{display:none!important}</style></Base>
