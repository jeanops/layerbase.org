---
import Base from '../layouts/Base.astro';
import {papers,experiments} from '../lib/data.mjs';
const base=import.meta.env.BASE_URL;
---
<Base title="Accueil"><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">✳ OUVERT AUX ESPRITS CURIEUX · EST. 2026</span><h1>Bienvenue au<br/><em>comptoir des</em><br/>hypothèses<br/>impossibles.</h1><p>Un bistrot philosophique aux frontières de la science, de l’intelligence et du cosmos. Ici, on ose poser les grandes questions. Et on prend le temps de vérifier les réponses.</p><div class="actions"><a class="btn" href={`${base}jeanpapelars/`}>Lire les Jeanpapelars ↗</a><a class="btn secondary" href={`${base}manifeste/`}>Notre manifeste →</a></div></div><div class="orbit" aria-hidden="true"><div class="orb-core"></div><span class="orb-label one">HYPOTHESIS_001</span><span class="orb-label two">QUESTION EVERYTHING / VERIFY SOMETHING</span></div></div></section>
<section class="section rule"><div class="container"><div class="section-head"><div><span class="eyebrow">01 / LES DERNIÈRES PENSÉES</span><h2>À lire au comptoir.</h2><p class="section-lead">Des idées au brouillon, des hypothèses en construction et des questions qui restent ouvertes.</p></div><a class="text-link" href={`${base}jeanpapelars/`}>Tous les Jeanpapelars ↗</a></div><div class="card-grid">{papers.map(p=><a class="card" href={`${base}jeanpapelars/${p.slug}/`}><span class="num">{p.section} / N° {p.num}</span><h3>{p.title}</h3><p>{p.subtitle}</p><div class="card-foot"><span class:list={['pill',p.status==='Hypothèse'?'goldpill':p.status==='Question ouverte'?'graypill':'']}>{p.status}</span><span class="arrow">↗</span></div></a>)}</div></div></section>
<section class="section rule"><div class="container feature"><div><span class="eyebrow">02 / PLUS LOIN QUE LES IDÉES</span><h2>Du comptoir<br/>au laboratoire.</h2><p class="section-lead">Une bonne intuition mérite mieux qu’un grand discours. On formule, on préenregistre les critères, on cherche ce qui pourrait la contredire. Et on laisse les résultats parler.</p><div class="actions"><a class="btn secondary" href={`${base}laboratoire/`}>Entrer dans le laboratoire →</a></div></div><div class="feature-panel"><span class="micro">PROTOCOLE / MÉTHODE</span><h3>Rien n’est acquis.</h3><p>Chaque projet conserve une séparation explicite entre observation, hypothèse, protocole et résultat.</p><div class="metrics"><div class="metric"><strong>{papers.length.toString().padStart(2,'0')}</strong><span>TEXTES EXEMPLES</span></div><div class="metric"><strong>{experiments.length.toString().padStart(2,'0')}</strong><span>FICHES LAB</span></div><div class="metric"><strong>0</strong><span>RÉSULTATS REVENDIQUÉS</span></div></div></div></div></section>
<section class="section"><div class="container banner"><span class="eyebrow">L'ESPRIT DU LIEU</span><h2>Les idées sont libres.<br/><span class="gold">Les preuves ont leurs exigences.</span></h2><p>Pas besoin d’avoir raison pour commencer à penser.</p><a href={`${base}manifeste/`} class="btn secondary">Lire le manifeste ↗</a></div></section></Base>
